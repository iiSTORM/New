# Node — build tooling only. The app ships as a single index.html and has
# no runtime dependencies beyond React from a CDN.
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Diagnostic / probe output captures.
# The scripts in scripts/dev/ write their stdout to .txt files in the repo
# root (see each script's header). Those are regenerable investigation
# artifacts, not source — keep them out of git.
*_probe*.txt
*_output*.txt
*_diagnosis.txt
*_debug.txt
scrape_cs2*.txt
hltv_*.txt
team_matches*.txt

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Raw provider payloads saved from a browser for the props pipeline.
# These are ~2MB each, they are an INPUT to scrape_props.py --fixture, and
# they are regenerable by reloading one URL. Only the small props.json the
# script produces from them belongs in git, so git stops offering to commit
# the payload every time one is dropped in the folder.
saved.json
payload.json
projections.json
*_payload.json
props_raw*.json
# The per-league filenames the README's three bookmarks lead to. Named
# individually rather than by a glob, so the committed data files next to
# them (data.json, cs2_data.json, valorant_data.json, props.json) cannot
# be caught by accident.
lol.json
cs2.json
val.json
valorant.json

# NOTE: the generated data files are deliberately NOT ignored.
# data.json, cs2_data.json, valorant_data.json, career_data.json,
# cs2_career_data.json, champion_stats.json and schedule.json are
# committed by .github/workflows/scrape.yml and served to the frontend
# from raw.githubusercontent.com — ignoring them would break the site.

# The scheduled prop refresh takes this as a lock so two runs cannot
# overlap. It is removed when the run finishes.
.props-refresh.lock/
request_counts.txt
